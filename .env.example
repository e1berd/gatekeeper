# ── Core ──────────────────────────────────────────────────────────────────────
GATEKEEPER_PORT=8080
GATEKEEPER_ISSUER=http://localhost:8080
LOG_LEVEL=info

# ── Postgres ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://gatekeeper:gatekeeper@localhost:5432/gatekeeper
DATABASE_POOL_MAX=10

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Leave empty to use in-process storage, which is correct for a single node.
# Set it only when several replicas must share one rate-limit budget.
REDIS_URL=

# ── Secrets ───────────────────────────────────────────────────────────────────
# KEK: master key encrypting every secret at rest (TOTP seeds, SSO client
# secrets, SAML private keys). 32 bytes, base64. Rotate via auth.encryption_keys.
#   openssl rand -base64 32
GATEKEEPER_KEK=CHANGE_ME_BASE64_32_BYTES

# Signing key for access tokens (Ed25519 PKCS#8, PEM). Generate with:
#   openssl genpkey -algorithm ed25519 -out signing.pem && cat signing.pem | base64 -w0
# Leave empty to auto-generate on first boot and persist into auth.signing_keys.
GATEKEEPER_SIGNING_KEY=

# ── Browser surfaces (/form/*) ────────────────────────────────────────────────
# Cookie domain. For an IdP on id.myapp.com serving myapp.com this must be the
# registrable parent, or the application never sees the session.
COOKIE_DOMAIN=
# Comma-separated allowlist. Unlisted redirect targets fall back to the issuer.
ALLOWED_REDIRECT_ORIGINS=http://localhost:3000,http://localhost:8080
# Origins permitted to submit /form/* . This is the primary CSRF defence; the
# signed token is only the fallback for clients that send no Origin header.
ALLOWED_FORM_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Only set when a reverse proxy actually terminates connections in front.
TRUST_PROXY=false

# ── WebAuthn / passkeys ───────────────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Gatekeeper
WEBAUTHN_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Mail ──────────────────────────────────────────────────────────────────────
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=no-reply@gatekeeper.local
